def rot_13(s):
	result = ""
	for char in s:
		if ('A' <= char <= 'Z'):
			result += chr((ord(char) - ord('A') + 13) % 26 + ord('A'))
		elif ('a' <= char <= 'z'):
			result += chr((ord(char) - ord('a') + 13) % 26 + ord('a'))
		else:
			result += char
	return result

# Example usage:
print(rot_13("Hello, World!"))  # Output: "Uryyb, Jbeyq!"
print(rot_13("Uryyb, Jbeyq!"))  # Output: "Hello, World!"